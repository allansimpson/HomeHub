# Copy to `deploy/deploy.env` and fill in. That file is gitignored (`*.env`) and holds no secrets —
# only where the server is. Secrets live on the server in /etc/homehub/homehub.env, which is
# root-owned and never leaves it.
#
#   cp deploy/deploy.env.example deploy/deploy.env

# The server, as ssh reaches it. A hostname here must also be in the panel certificate's SANs
# (scripts/make-panel-cert.sh), or phones get a name-mismatch warning and no camera.
PANEL_HOST=homehub.local

# The account deploy.sh logs in as. NOT the account the service runs as — that is the unprivileged
# `homehub` system user, created by bootstrap-server.sh, which never needs a login or a shell.
PANEL_SSH_USER=allan

# Optional overrides — the defaults are what bootstrap-server.sh sets up.
#PANEL_SSH_PORT=22
#REMOTE_ROOT=/opt/homehub
#SERVICE=homehub

# Where deploy.sh PROBES for health and what URLs it prints. These do NOT set the app's bind port —
# that is Server__HttpPort/Server__HttpsPort in /etc/homehub/homehub.env, and the two must agree.
# Nothing checks that they do: when they disagreed here, a good deploy reported failure because the
# health check curled a port nothing was listening on.
HTTP_PORT=5080
HTTPS_PORT=5081

# How many past releases to keep on the server for rollback. Each is a self-contained publish
# (~100 MB), so this is the disk/rollback trade.
#KEEP_RELEASES=5
