# The TEST instance — `/opt/homehub-test` under `homehub-test.service`.
#
#   cp deploy/deploy-test.env.example deploy/deploy-test.env
#   DEPLOY_ENV=deploy/deploy-test.env bash scripts/deploy.sh
#
# A whole file rather than a couple of inline variables, because deploy.sh sources this with
# `set -a`: anything named here beats what was in the environment, so a half-override is not a
# thing you can express. Everything that differs from production has to be stated, and the two that
# bite if they are not are `SERVICE_GROUP` and `HTTP_PORT` — see below.
#
# Gitignored (`*.env`), and holds no secrets: only where the instance is. The test instance's own
# settings live on the server in /etc/homehub-test/homehub-test.env.
#
# server-systemd.md is explicit that this environment is provisioned out-of-band — "which is exactly
# how it ends up one setting behind production". This file is the deploy half of that gap, not a
# closing of it: it says where to put a release, and nothing about whether the instance's state
# directories, ports and paths match what the release expects.

# Usually the same box as production. Same ssh account, too — the deploy account, not the service one.
PANEL_HOST=192.168.5.15
PANEL_SSH_USER=simpson
#PANEL_SSH_PORT=22

# Where releases land and which unit is restarted. **These two are what make it the test instance**;
# omit them and this file deploys to production while claiming not to.
REMOTE_ROOT=/opt/homehub-test
SERVICE=homehub-test

# The group the *test* service account runs under — releases are chgrp'd to it, and a release
# carrying production's group is one the test service cannot read. It presents as a service that
# will not start, on files that look perfectly fine.
#
# Confirm rather than assume:  systemctl show homehub-test -p User -p Group
SERVICE_GROUP=homehub-test

# Where deploy.sh PROBES for health, and what it prints when it finishes. These do NOT bind
# anything — the instance's real ports are Server__HttpPort/Server__HttpsPort in
# /etc/homehub-test/homehub-test.env, and the two must agree.
#
# **The failure here is silent and worth understanding.** The readiness probe runs on the server as
# `curl http://127.0.0.1:$HTTP_PORT/api/health?deep=true`. Left at production's 5080 it would ask
# *production* whether it is healthy — and production would answer yes — so a test deploy that
# unpacked a broken release, flipped the symlink and left the test service dead would print
# "Deployed" and a green health line.
HTTP_PORT=
HTTPS_PORT=

# Fewer than production's five: this environment exists to be replaced often, and each release is a
# self-contained publish of ~100 MB.
KEEP_RELEASES=3
