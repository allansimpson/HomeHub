# Copy to .env and adjust. All values have defaults (see config.py); these are the ones you'll set.

# --- HomeHub API (the .NET app) ---
HOMEHUB_API_BASE_URL=http://home-server:5220
# Bearer credential for the API. REQUIRED — every HomeHub endpoint needs authentication (AUDIT A1),
# and the bridge is a program with no browser, so it presents this rather than holding a session
# cookie. It must match an entry the server knows:
#
#   Auth__ServiceTokens__Tokens__voice-bridge=<the same value>
#
# in /etc/homehub/homehub.env. Generate one with `openssl rand -hex 32`. A service credential can
# read and act on the house; it cannot reach any member's own data or change the household roster.
HOMEHUB_SERVICE_TOKEN=
# Transcribe and speak. Short on purpose: both are local, and one that hangs is broken.
HOMEHUB_HTTP_TIMEOUT=30
# How long a spoken turn may take. Matches the server's own ceiling (Hermes:StreamTimeoutSeconds) —
# an agent reaching for a tool takes as long as the question needs, and hanging up on it is the one
# failure nobody in the kitchen can see coming. Raise both together or neither.
HOMEHUB_CHAT_TIMEOUT=600

# --- Wake word (openWakeWord) ---
# One model per phrase, comma-separated; any of them opens the mic. openWakeWord matches sound, not
# text, so a phrase listed in WAKE_PHRASE with no model of its own is never actually heard — see the
# README for training each .onnx. If WAKE_MODEL_PATH is unset entirely, the pretrained WAKE_MODEL is
# used as a stand-in for all of them.
WAKE_MODEL_PATH=/opt/homehub-voice/models/hey_barnaby.onnx,/opt/homehub-voice/models/oh_barnaby.onnx
WAKE_MODEL=hey_jarvis
WAKE_FRAMEWORK=onnx
WAKE_THRESHOLD=0.5
# Display labels only, for logs. Keep in step with the models above.
WAKE_PHRASE=Hey Barnaby, Oh Barnaby

# --- Audio capture ---
# MIC_DEVICE=            # sounddevice name/index; leave blank for the system default
VAD_AGGRESSIVENESS=2
START_TIMEOUT_MS=3000
END_SILENCE_MS=900
MIN_SPEECH_MS=300
MAX_UTTERANCE_MS=15000

# --- TTS (Piper, "norman" voice) ---
PIPER_BIN=piper
PIPER_MODEL=/opt/homehub-voice/voices/en_US-norman-medium.onnx
TTS_SAMPLE_RATE=22050
# APLAY_DEVICE=          # ALSA device for `aplay -D`; blank for default

# --- Conversation ---
HISTORY_TURNS=4
