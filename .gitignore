bin/
obj/
*.user
*.suo
.vs/
publish/
artifacts/
project.lock.json
*.nupkg

# ---- EF / local db ----
*.mdf
*.ldf

# ---- Azurite (local storage emulator state, churns constantly) ----
__azurite_db_*.json
__azurite_db_*__.json
__blobstorage__/
__queuestorage__/
__tablestorage__/

# ---- Secrets (never commit) ----
appsettings.*.Local.json
secrets.json
*.env
.env
.env.*

# Local scratch notes — has held pasted secrets (keys/connection strings); keep out of git.
NOTES.md

