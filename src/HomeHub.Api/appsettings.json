{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Voice": {
    "Stt": {
      "LocalEndpoint": "",
      "LocalModel": "base.en",
      "AllowCloudFallback": true,
      "Prefer": "local",
      "TimeoutSeconds": 120
    },
    "Tts": {
      "Primary": "piper",
      "FirstAudioDeadlineSeconds": 2.5,
      "CacheDirectory": "",
      "PiperPath": "",
      "VoiceModel": "",
      "TimeoutSeconds": 30,
      "Chatterbox": {
        "Endpoint": "",
        "Model": "chatterbox-turbo",
        "Voice": "house",
        "ResponseFormat": "wav",
        "TimeoutSeconds": 30
      }
    }
  },
  "OpenFoodFacts": {
    "//": "Barcode -> product name for the pantry scanner. Open data, no API key. The pantry's only",
    "//_2": "call off the LAN: it sends a barcode and nothing else. Set Enabled false to turn every",
    "//_3": "outbound lookup off — scanning still works, each new pack just needs naming once.",
    "Enabled": true,
    "BaseUrl": "https://world.openfoodfacts.org",
    "UserAgent": "HomeHub/1.0 (household wall panel; personal use)",
    "TimeoutSeconds": 4,
    "CacheHours": 6
  },
  "Huckleberry": {
    "Enabled": true,
    "Children": [],
    "ChildNames": {},
    "CalendarEntityFormat": "calendar.{0}_events",
    "CacheSeconds": 10
  },
  "Cats": {
    "Enabled": true,
    "Robots": [],
    "RobotNames": {},
    "CacheSeconds": 10,
    "Recovery": {
      "Enabled": true,
      "PollSeconds": 30,
      "DebounceSeconds": 90,
      "CatSettleSeconds": 120,
      "ResetSettleSeconds": 35,
      "CycleSettleSeconds": 35,
      "StableConfirmSeconds": 300,
      "MaxAttemptsPerEpisode": 3,
      "MaxAttemptsPerDay": 6,
      "BackoffMinutes": [ 5, 15 ],
      "LitterFloorPercent": 5
    }
  }
}
